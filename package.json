{
  "name": "revgrid",
  "version": "0.11.1",
  "description": "Canvas based high performance grid",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/code/index.js"
    }
  },
  "sideEffects": false,
  "homepage": "https://revgrid.github.io/revgrid/",
  "repository": {
    "type": "git",
    "url": "git://github.com/revgrid/revgrid.git"
  },
  "contributors": [
    "Paul Klink (https://paul.klink.au)"
  ],
  "license": "MIT",
  "readmeFilename": "README.md",
  "keywords": [
    "grid",
    "canvas",
    "virtual",
    "performance",
    "realtime"
  ],
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "src/**/*.json",
    "src/**/*.css"
  ],
  "scripts": {
    "link-pbkware": "npm link @pbkware/js-utils",
    "lint": "eslint",
    "build": "tsc --build ./src/code/tsconfig.json",
    "force-build": "tsc --build --force ./src/code/tsconfig.json",
    "lib": "tsc --project ./src/code/tsconfig.json --emitDeclarationOnly",
    "rollup": "npx api-extractor run --local --verbose",
    "types": "npm run lib && npm run rollup",
    "api": "npm run build && npm run rollup",
    "force-api": "npm run force-build && npm run rollup",
    "clean": "npx del-cli ./dist && npx del-cli ./lib",
    "dist": "npm run clean && npm run force-api && copyfiles -f src/style/revgrid.css dist/css",
    "bundles": "webpack --config ./webpack.bundles.js",
    "clienttestapp": "tsc --project ./test-app/client/tsconfig.json",
    "clienttestapp:build": "vite build --config ./test-app/client/vite.docs.config.mjs",
    "clienttestapp:serve": "vite --config ./test-app/client/vite.dev.config.mjs --host",
    "recordtestapp": "tsc --project ./test-app/record/tsconfig.json",
    "recordtestapp:build": "vite build --config ./test-app/record/vite.docs.config.mjs",
    "recordtestapp:serve": "vite --config ./test-app/record/vite.dev.config.mjs --host",
    "dratestapp": "tsc --project ./test-app/data-row-array/tsconfig.json",
    "dratestapp:build": "vite build --config ./test-app/data-row-array/vite.docs.config.mjs",
    "dratestapp:serve": "vite --config ./test-app/data-row-array/vite.dev.config.mjs --host",
    "docs:update": "typedoc --options ./typedoc.json --cleanOutputDir false",
    "docs:build": "typedoc --options ./typedoc.json",
    "docs:full": "npm run docs:build && npm run clienttestapp:build && npm run recordtestapp:build && npm run dratestapp:build",
    "docs:serve": "vite --config ./vite.docs-dev.config.mjs --host"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.7",
    "copyfiles": "2.4.1",
    "css-loader": "7.1.4",
    "del-cli": "7.0.0",
    "eslint": "10.4.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "html-webpack-plugin": "5.6.7",
    "source-map-loader": "5.0.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.2",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.14"
  },
  "browserslist": [
    "last 1 Chrome version",
    "last 1 Firefox version",
    "last 2 Edge major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "Firefox ESR"
  ],
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@pbkware/js-utils": "0.9.1"
  }
}